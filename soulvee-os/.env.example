# --- AI (Claude) ---
# Turns on the AI agent, content generator, offer builder, follow-up writer and lessons.
ANTHROPIC_API_KEY=
# Optional: which Claude model to use. The README lists the default.
# SOULVEE_MODEL=

# --- Social publishing (optional; pick one or both) ---
# Buffer posts to Instagram, TikTok, Facebook, LinkedIn, X, Threads, YouTube and Pinterest.
# Get a key in Buffer: Settings -> API.
# BUFFER_API_KEY=
# Or a Make / Zapier / n8n webhook that Soulvee OS calls at the scheduled time:
# SOCIAL_WEBHOOK_URL=
# Optional: signs each webhook call (x-soulvee-signature) so the scenario can check it came from you.
# SOCIAL_WEBHOOK_SECRET=

# --- Images (optional) ---
# Makes an image from each post's visual brief.
# OPENAI_API_KEY=
# Optional: SOULVEE_IMAGE_MODEL (default gpt-image-2), SOULVEE_IMAGE_QUALITY (low, medium, high)
# Hosts images at permanent public links so Buffer can post them (from your Cloudinary dashboard):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or, if this server is online, its public address; images are then served at PUBLIC_URL/media/...
# PUBLIC_URL=https://soulvee.example.com

# --- Connected accounts (optional; see docs/PLATFORMS.md) ---
# Facebook Pages and Instagram (and checking WhatsApp webhook calls): your Meta app.
# META_APP_ID=
# META_APP_SECRET=
# Threads: the Threads use case of your Meta app (its own ID and secret).
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# X: an OAuth 2.0 app at developer.x.com.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# LinkedIn: an app at linkedin.com/developers. For company pages, once LinkedIn approves the
# Community Management API, also set LINKEDIN_SCOPES (see docs/PLATFORMS.md).
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Gmail: an OAuth client in Google Cloud with the Gmail API enabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Telegram, WhatsApp, Reddit and Signal are connected from the Accounts tab, not here.
# Sign-ins return to PUBLIC_URL/oauth/callback/<platform> (or http://localhost:8787 without PUBLIC_URL),
# and WhatsApp needs PUBLIC_URL for its webhook: PUBLIC_URL/webhooks/meta.

# --- Hosting ---
# PORT=8787
# Needed on a public host, in Docker, or to use AI, images and publishing from another device; without it
# they only work on this computer. Open the app once on each device with ?token=YOUR_TOKEN.
# SOULVEE_ACCESS_TOKEN=
# Where connected accounts, inbox messages, the posting queue, autopilot data and hosted images are kept (default: ./data)
# SOULVEE_DATA_DIR=
