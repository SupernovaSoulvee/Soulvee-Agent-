---
const menu = [
  { group: "Dim Sum", name: "Har Gao Crystal Prawn", tag: "Signature", price: "₦18,500", note: "Translucent parcels with gingered tiger prawn." },
  { group: "Dim Sum", name: "Truffle Siu Mai", tag: "Chef's Pick", price: "₦17,000", note: "Chicken, shrimp, shiitake, and black truffle oil." },
  { group: "Dim Sum", name: "Char Siu Bao", tag: "Best Seller", price: "₦14,500", note: "Cloud-soft buns with lacquered honey barbecue filling." },
  { group: "Dim Sum", name: "Lotus Leaf Sticky Rice", tag: "House Special", price: "₦16,000", note: "Steamed rice, mushroom, sausage, and soy glaze." },
  { group: "Dim Sum", name: "Chive & Scallop Dumplings", tag: "New", price: "₦19,000", note: "Pan-seared jade dumplings with scallop mousse." },
  { group: "Soups", name: "Suzhou Wonton Broth", tag: "Signature", price: "₦15,500", note: "Silken wontons, preserved greens, and clear chicken broth." },
  { group: "Soups", name: "Hot & Sour Silk Tofu", tag: "Chef's Pick", price: "₦13,500", note: "Black vinegar, bamboo shoots, cloud ear, and tofu ribbons." },
  { group: "Soups", name: "Crab Sweetcorn Velouté", tag: "Best Seller", price: "₦18,000", note: "Blue crab, golden corn, egg flowers, and sesame." },
  { group: "Soups", name: "Double-Boiled Herbal Chicken", tag: "House Special", price: "₦22,000", note: "Goji, dates, angelica, and slow-steeped poultry jus." },
  { group: "Soups", name: "Seafood Laksa Consommé", tag: "Spiced", price: "₦20,500", note: "Prawn, mussel, coconut aromatics, and chili oil." },
  { group: "Wok Specialties", name: "Antique Gold Orange Duck", tag: "Signature", price: "₦32,000", note: "Crisped duck breast, burnt orange, and Shaoxing caramel." },
  { group: "Wok Specialties", name: "Black Pepper Beef Tenderloin", tag: "Best Seller", price: "₦35,000", note: "Tenderloin cubes, bell peppers, and pearl onions." },
  { group: "Wok Specialties", name: "Kung Pao Tiger Prawns", tag: "Chef's Pick", price: "₦31,500", note: "Cashew, dry chili, scallion, and sweet soy vinegar." },
  { group: "Wok Specialties", name: "Mapo Aubergine Claypot", tag: "Vegetarian", price: "₦21,000", note: "Smoked eggplant, fermented bean, and numbing pepper." },
  { group: "Wok Specialties", name: "Crispy Sichuan Chicken", tag: "House Special", price: "₦27,000", note: "Twice-fried chicken with chili crisp and sesame salt." },
  { group: "Noodles & Rice", name: "Suzhou Scallion Oil Noodles", tag: "Signature", price: "₦16,500", note: "Hand-pulled noodles with dark soy and caramelized scallion." },
  { group: "Noodles & Rice", name: "XO Seafood Fried Rice", tag: "Chef's Pick", price: "₦24,000", note: "Shrimp, calamari, egg, jasmine rice, and house XO." },
  { group: "Noodles & Rice", name: "Beef Ho Fun", tag: "Best Seller", price: "₦23,500", note: "Wide rice noodles, wok hei beef, and bean sprouts." },
  { group: "Noodles & Rice", name: "Dan Dan Lagos", tag: "Spiced", price: "₦19,500", note: "Sesame chili sauce, minced chicken, peanut, and greens." },
  { group: "Noodles & Rice", name: "Golden Pineapple Rice", tag: "Vegetarian", price: "₦18,000", note: "Cashew, pineapple, carrots, and saffron-tinted jasmine rice." },
  { group: "Flaky Pastries", name: "Red Bean Moon Puff", tag: "Signature", price: "₦11,500", note: "Layered pastry with red bean paste and sesame." },
  { group: "Flaky Pastries", name: "Custard Egg Tart", tag: "Best Seller", price: "₦9,500", note: "Burnished custard in a shattering butter shell." },
  { group: "Flaky Pastries", name: "Five-Spice Beef Pie", tag: "House Special", price: "₦14,000", note: "Golden hand pie with aromatic minced beef." },
  { group: "Flaky Pastries", name: "Pineapple Pearl Tart", tag: "Chef's Pick", price: "₦12,000", note: "Tangy pineapple jam, almond crumb, and pearl sugar." },
  { group: "Flaky Pastries", name: "Matcha Coconut Roll", tag: "New", price: "₦10,500", note: "Green tea sponge, coconut cream, and toasted flakes." },
]

const groups = ["Dim Sum", "Soups", "Wok Specialties", "Noodles & Rice", "Flaky Pastries"]
const socials = ["Instagram", "Facebook", "TikTok", "YouTube", "Twitter/X", "WhatsApp"]
---

<main class="site">
  <section class="hero" id="top">
    <div class="cloud cloud-a"></div>
    <div class="cloud cloud-b"></div>
    <div class="lanterns" aria-hidden="true">
      <span>福</span><span>壽</span><span>喜</span><span>財</span>
    </div>
    <div class="hero-copy">
      <p class="eyebrow">Porcelain & Ink dining in Lagos</p>
      <h1><span>蘇 州</span> Su Chau By Flaky</h1>
      <p>Dim sum, wok-fired classics, silken soups, and flaky patisserie served with antique-gold ceremony.</p>
      <div class="actions">
        <a href="#menu">Order online</a>
        <a href="#reservations">Reserve a table</a>
      </div>
    </div>
  </section>

  <section class="intro">
    <p>Deep teal-black interiors, cool sage-white table settings, and a kitchen built around the rhythm of steam, flame, and pastry lamination.</p>
  </section>

  <section class="menu" id="menu">
    <div class="section-head">
      <p class="eyebrow">Online menu & ordering</p>
      <h2>25 house favourites</h2>
      <button class="cart-toggle" type="button">Cart <strong data-cart-count>0</strong></button>
    </div>
    <div class="tabs" role="tablist" aria-label="Menu categories">
      {groups.map((group, index) => <button class:list={{ active: index === 0 }} type="button" data-tab={group}>{group}</button>)}
    </div>
    <div class="dishes">
      {menu.map((dish) => (
        <article class:list={["dish", { hidden: dish.group !== groups[0] }]} data-group={dish.group}>
          <div>
            <span>{dish.tag}</span>
            <h3>{dish.name}</h3>
            <p>{dish.note}</p>
          </div>
          <footer>
            <strong>{dish.price}</strong>
            <button type="button" data-add={dish.name} data-price={dish.price}>Add</button>
          </footer>
        </article>
      ))}
    </div>
  </section>

  <aside class="drawer" data-drawer aria-label="Cart drawer">
    <button class="close" type="button" data-close>×</button>
    <h2>Your order</h2>
    <div data-cart-list class="cart-list"><p>No dishes added yet.</p></div>
    <p class="checkout">Checkout will continue with Paystack after the restaurant confirms availability.</p>
  </aside>

  <section class="reservations" id="reservations">
    <div>
      <p class="eyebrow">Reservations</p>
      <h2>Book the porcelain room</h2>
      <p>Send your preferred date and party size. A host will confirm by phone or email.</p>
    </div>
    <form data-reservation>
      <input aria-label="Name" placeholder="Name" required />
      <input aria-label="Phone" placeholder="Phone" required />
      <input aria-label="Email" type="email" placeholder="Email" required />
      <input aria-label="Date" type="date" required />
      <input aria-label="Time" type="time" required />
      <input aria-label="Party size" type="number" min="1" max="20" placeholder="Party size" required />
      <textarea aria-label="Special requests" placeholder="Special requests"></textarea>
      <button type="submit">Request reservation</button>
      <p class="confirm" data-confirm hidden>Thank you — your reservation request has been received.</p>
    </form>
  </section>

  <section class="socials">
    <p class="eyebrow">Social media</p>
    <h2>Follow the kitchen</h2>
    <div>
      {socials.map((social) => <a href="#" class={social.toLowerCase().replace("/", "-")}>{social}<small>@suchaub flaky</small></a>)}
    </div>
  </section>

  <section class="contact">
    <p><strong>Address</strong> Victoria Island, Lagos</p>
    <p><strong>Hours</strong> Mon–Sun, 12:00–22:30</p>
    <p><strong>Phone</strong> +234 800 000 0000</p>
  </section>
</main>

<script>
  const cart = []
  const count = document.querySelector("[data-cart-count]")
  const list = document.querySelector("[data-cart-list]")
  const drawer = document.querySelector("[data-drawer]")

  document.querySelectorAll("[data-tab]").forEach((tab) => {
    tab.addEventListener("click", () => {
      const group = tab.getAttribute("data-tab")
      document.querySelectorAll("[data-tab]").forEach((item) => item.classList.toggle("active", item === tab))
      document.querySelectorAll("[data-group]").forEach((item) => item.classList.toggle("hidden", item.getAttribute("data-group") !== group))
    })
  })

  document.querySelectorAll("[data-add]").forEach((button) => {
    button.addEventListener("click", () => {
      cart.push(`${button.getAttribute("data-add")} — ${button.getAttribute("data-price")}`)
      count.textContent = String(cart.length)
      list.innerHTML = cart.map((item) => `<p>${item}</p>`).join("")
      drawer.classList.add("open")
      button.classList.remove("stamp")
      requestAnimationFrame(() => button.classList.add("stamp"))
    })
  })

  document.querySelector("[data-close]").addEventListener("click", () => drawer.classList.remove("open"))
  document.querySelector(".cart-toggle").addEventListener("click", () => drawer.classList.add("open"))
  document.querySelector("[data-reservation]").addEventListener("submit", (event) => {
    event.preventDefault()
    document.querySelector("[data-confirm]").hidden = false
  })
</script>

<style>
@import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;700&family=Inter:wght@400;600;800&display=swap");

:global(body) { margin: 0; background: #edf3ec; color: #17322f; font-family: Inter, sans-serif; }
.site { overflow: hidden; }
.hero { min-height: 100vh; position: relative; display: grid; place-items: center; padding: 4rem 1.5rem; background: radial-gradient(circle at 30% 15%, #214a45, #071716 70%); color: #fff8e8; text-align: center; }
.hero-copy { max-width: 850px; z-index: 2; }
.eyebrow { color: #b89244; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
h1, h2, h3 { font-family: "Cormorant Garamond", serif; }
h1 { font-size: clamp(4rem, 11vw, 9rem); line-height: .8; margin: 0 0 1.5rem; }
h1 span { display: block; color: #d8b15d; letter-spacing: .2em; font-size: .45em; margin-bottom: 1rem; }
h2 { font-size: clamp(2.5rem, 6vw, 5rem); margin: 0; }
.hero p:not(.eyebrow), .intro { font-size: clamp(1.1rem, 2vw, 1.45rem); line-height: 1.7; }
.actions { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; margin-top: 2rem; }
.actions a, form button, .cart-toggle { border: 1px solid #d8b15d; background: #d8b15d; color: #071716; padding: 1rem 1.4rem; border-radius: 999px; font-weight: 800; text-decoration: none; }
.actions a + a { background: transparent; color: #fff8e8; }
.lanterns { position: absolute; inset: 2rem 8vw auto; display: flex; justify-content: space-between; }
.lanterns span { width: 74px; height: 96px; display: grid; place-items: center; border-radius: 48% 48% 42% 42%; background: #9e1f1f; color: #ffd879; font: 700 2rem "Cormorant Garamond"; box-shadow: 0 0 35px #9e1f1f77; animation: sway 4s ease-in-out infinite; transform-origin: top; }
.lanterns span:nth-child(2), .lanterns span:nth-child(4) { animation-delay: -1.5s; }
.cloud { position: absolute; width: 260px; height: 80px; border: 1px solid #ffffff22; border-radius: 999px; opacity: .5; animation: drift 18s linear infinite; }
.cloud-a { left: 5%; top: 36%; }
.cloud-b { right: 3%; bottom: 22%; animation-duration: 24s; }
.intro, .menu, .reservations, .socials { padding: clamp(3rem, 7vw, 7rem); }
.intro { background: #f8f3e8; color: #25443f; text-align: center; }
.section-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem; }
.tabs { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: 2rem; }
.tabs button { border: 1px solid #9bb4a5; background: #fffaf0; color: #17322f; padding: .85rem 1rem; border-radius: 999px; font-weight: 800; }
.tabs .active { background: #17322f; color: #fff8e8; }
.dishes { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }
.dish { min-height: 250px; display: flex; flex-direction: column; justify-content: space-between; padding: 1.25rem; border: 1px solid #cdd8cb; border-radius: 26px; background: linear-gradient(145deg, #fffaf0, #e4eee3); }
.dish.hidden { display: none; }
.dish span { color: #9e1f1f; font-weight: 800; }
.dish h3 { font-size: 2rem; margin: .5rem 0; }
.dish p { line-height: 1.55; }
.dish footer { display: flex; align-items: center; justify-content: space-between; }
.dish button { position: relative; border: 0; border-radius: 999px; background: #17322f; color: #fff8e8; padding: .75rem 1rem; font-weight: 800; }
.dish button.stamp::after { content: ""; position: absolute; inset: -18px; border: 4px solid #9e1f1f; border-radius: 50%; animation: stamp .7s ease-out; }
.drawer { position: fixed; inset: 0 0 0 auto; width: min(420px, 92vw); padding: 2rem; background: #fffaf0; color: #17322f; box-shadow: -20px 0 60px #0005; transform: translateX(110%); transition: .3s ease; z-index: 20; }
.drawer.open { transform: translateX(0); }
.close { float: right; border: 0; background: #9e1f1f; color: white; border-radius: 50%; width: 40px; height: 40px; font-size: 1.5rem; }
.checkout { border-top: 1px solid #d8b15d; padding-top: 1rem; }
.reservations { display: grid; grid-template-columns: 1fr 1.2fr; gap: 2rem; background: #17322f; color: #fff8e8; }
form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
input, textarea { border: 1px solid #d8b15d66; border-radius: 16px; background: #fffaf0; padding: 1rem; font: inherit; }
textarea, form button, .confirm { grid-column: 1 / -1; }
.confirm { color: #d8b15d; font-weight: 800; }
.socials div { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1rem; margin-top: 2rem; }
.socials a { padding: 1.5rem; border-radius: 24px; background: #fffaf0; color: #17322f; text-decoration: none; font-weight: 900; box-shadow: inset 0 0 0 1px #d8b15d55; transition: .2s ease; }
.socials a:hover { transform: translateY(-6px); background: #17322f; color: #fff8e8; }
.socials small { display: block; margin-top: .5rem; color: #b89244; }
.contact { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: #d8b15d; }
.contact p { margin: 0; padding: 1.5rem; background: #071716; color: #fff8e8; }
.contact strong { display: block; color: #d8b15d; }
@keyframes sway { 50% { transform: rotate(6deg); } }
@keyframes drift { 50% { transform: translateX(80px); } }
@keyframes stamp { from { transform: scale(.2); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }
@media (max-width: 760px) { .reservations, .contact { grid-template-columns: 1fr; } form { grid-template-columns: 1fr; } .lanterns { inset-inline: 1rem; } .lanterns span { width: 54px; height: 74px; } }
</style>
